                  "@type": "Question",
                  "name": "How do I book a tour, and do I need to pay in advance?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Booking is incredibly simple and direct! You can click the WhatsApp button on our website to chat with our local team and check availability. No payment is required just to inquire or reserve your spot."
                  }
                },
